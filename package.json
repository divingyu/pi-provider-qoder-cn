{
  "name": "pi-provider-qoder-cn",
  "version": "0.2.19",
  "description": "Pi extension for Qoder CN — PAT/OAuth auth, /qoder-cn.usage quota command, and enterprise VPC endpoint support",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "author": "divingyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divingyu/pi-provider-qoder-cn.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "qoder",
    "qoder-cn",
    "ai",
    "provider"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai/compat",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/@biomejs/biome/bin/biome check .",
    "lint:fix": "node node_modules/@biomejs/biome/bin/biome check --write .",
    "format": "node node_modules/@biomejs/biome/bin/biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsx scripts/record-live-fixtures.ts",
    "prepublishOnly": "npm run check && npm run lint && npm run test && npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
